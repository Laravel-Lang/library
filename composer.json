{
    "name": "laravel-lang/library",
    "description": "A shared set of translated phrases for the Laravel-Lang ecosystem",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "i18n",
        "locales",
        "localization",
        "translation",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
